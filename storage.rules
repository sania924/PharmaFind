rules_version = '2';

// Firebase Storage Security Rules for PharmFind
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() &&
             request.auth.token.role == 'admin';
    }

    // Helper function to validate image file
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024 && // 5MB max
             request.resource.contentType.matches('image/.*');
    }

    // Medicines images folder
    // Only admins can upload/update/delete
    // Everyone can read
    match /medicines/{imageId} {
      allow read: if true; // Public read access
      allow write: if isAdmin() && isValidImage(); // Admin only with validation
      allow delete: if isAdmin(); // Admin only
    }

    // Pharmacy images folder (if needed in future)
    match /pharmacies/{imageId} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // User profile images (if needed in future)
    match /users/{userId}/{imageId} {
      allow read: if true;
      allow write: if isAuthenticated() &&
                     (request.auth.uid == userId || isAdmin()) &&
                     isValidImage();
      allow delete: if isAuthenticated() &&
                      (request.auth.uid == userId || isAdmin());
    }

    // Deny all other paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
